# Neo4j AuraDB — HTTP Query API (nunca Bolt)
NEO4J_QUERY_URL=
NEO4J_USER=
NEO4J_PASSWORD=

# Cloudflare R2 (bucket privado, sem acesso público)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phronesis

# Vercel AI Gateway — porta única de modelo. Todo tráfego de LLM sai por
# aqui: STT, extração, resolução, desempate, perfil, enriquecimento,
# deduplicação, calibração, embedding, confronto, chat e título. É a única
# chave de modelo do sistema; chave de provedor não entra neste arquivo.
AI_GATEWAY_API_KEY=
# Opcional: troca de provedor sem tocar em código. Padrão: xai/grok-stt
# (é o único modelo deste Gateway com tempo por palavra — ARCHITECTURE.md §4.2.1)
STT_MODEL=
# Opcional: modelo da extracao de atomos. Padrao: zai/glm-5.3-flash
EXTRACAO_MODEL=
# Opcional: modelo que julga se duas entidades sao a mesma. Padrao: zai/glm-5.3-flash
DUPLICATAS_MODEL=
# Opcional: modelo que decide de quem eu estava falando (slice 4, agente 2).
# Padrao: o mesmo da extracao.
RESOLUCAO_MODEL=
# Opcional: modelo da segunda passada — a menção que voltou com confianca abaixo
# do limiar (slice 4.11). Padrao: o mesmo da resolucao.
DESEMPATE_MODEL=
# Opcional: modelo que rascunha o texto de um campo de perfil (slice 4, agente 3).
# Padrao: o mesmo da extracao.
PERFIL_MODEL=
# Opcional: modelo que escreve a ficha inteira de uma entidade a partir de TODOS
# os atomos que falam dela (slice 4.12, agente 4). Padrao: o mesmo da extracao.
# E o candidato mais provavel a ser separado: le a entrada mais longa do sistema
# e escreve o texto que os dois agentes leem em toda chamada depois.
ENRIQUECIMENTO_MODEL=
# Opcional: modelo que le as minhas correcoes de um agente e diz que padrao elas
# revelam (slice 4.6, generalizado na 7). Padrao: o mesmo da extracao.
CALIBRACAO_MODEL=
# Opcional: modelo que transforma um padrao confirmado em emenda ao prompt do
# agente, secao por secao (slice 7). Padrao: o mesmo da calibracao.
REDACAO_MODEL=
# Opcional: modelo que decide se dois atomos se relacionam — ATUALIZA, CONTRADIZ,
# CONFIRMA ou COMPLEMENTA (slice 5). Padrao: o mesmo da extracao.
CONFRONTO_MODEL=
# Opcional: modelo do chat (slice 6) — o unico agente que usa tool-calling
# multi-passo, encadeando ate 8 buscas antes de responder. Padrao: o mesmo da
# extracao, que foi escolhido para devolver JSON curto e nao para isso; se ele
# encadear mal, e aqui que se troca, sem deploy.
CHAT_MODEL=
# Opcional: modelo que da nome a uma conversa a partir da primeira troca
# (slice 6). Padrao: o mesmo do chat — e a chamada mais barata do sistema.
CHAT_TITULO_MODEL=
# Opcional: modelo de embedding (slice 4.5). Padrao: openai/text-embedding-3-small.
# TEM QUE SER DE 1536 DIMENSOES — e o que os indices vetoriais da migration 006
# declaram. Trocar para outra dimensao pede DROP e recriar os dois, por
# migration nova; src/lib/embedding.ts estoura antes de o banco reclamar.
EMBEDDING_MODEL=

# Auth: magic link, um único e-mail permitido
AUTH_SECRET=
ALLOWED_EMAIL=
# Entrega do magic link (Resend, por fetch — sem SDK). Nao e chave de modelo: a
# regra inviolavel 8 governa trafego de LLM. Sem dominio verificado o Resend so
# entrega ao dono da conta, que tem que ser o mesmo endereco do ALLOWED_EMAIL.
# Ausente, o link sai so no log da funcao — que e como o `pnpm dev` funciona,
# porque fora de producao ele tambem volta no corpo da resposta.
RESEND_API_KEY=

# A batida diaria (vercel.json): dump do grafo para o R2, e a consulta que
# impede a instancia Aura Free de ser pausada por 72h de silencio. A Vercel so
# manda o header `Authorization: Bearer` se esta variavel existir; o middleware
# a confere, e so sob /api/cron/.
CRON_SECRET=
