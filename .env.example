# Neo4j AuraDB — HTTP Query API (nunca Bolt)
NEO4J_QUERY_URL=
NEO4J_USER=
NEO4J_PASSWORD=

# Cloudflare R2 (bucket privado, sem acesso público)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phronesis

# Vercel AI Gateway — porta única de modelo. Todo tráfego de LLM sai por
# aqui: STT agora, extração e deduplicação a partir da slice 2. É a única
# chave de modelo do sistema; chave de provedor não entra neste arquivo.
AI_GATEWAY_API_KEY=
# Opcional: troca de provedor sem tocar em código. Padrão: xai/grok-stt
# (é o único modelo deste Gateway com tempo por palavra — ARCHITECTURE.md §4.2.1)
STT_MODEL=
# Opcional: modelo da extracao de atomos. Padrao: zai/glm-5.3-flash
EXTRACAO_MODEL=
# Opcional: modelo que julga se duas entidades sao a mesma. Padrao: zai/glm-5.3-flash
DUPLICATAS_MODEL=
# Opcional: modelo que decide de quem eu estava falando (slice 4, agente 2).
# Padrao: o mesmo da extracao.
RESOLUCAO_MODEL=
# Opcional: modelo que rascunha o texto de um campo de perfil (slice 4, agente 3).
# Padrao: o mesmo da extracao.
PERFIL_MODEL=
# Opcional: modelo que le as minhas correcoes e rascunha uma regra nova para o
# prompt de extracao (slice 4.6, agente 4). Padrao: o mesmo da extracao.
CALIBRACAO_MODEL=
# Opcional: modelo de embedding (slice 4.5). Padrao: openai/text-embedding-3-small.
# TEM QUE SER DE 1536 DIMENSOES — e o que os indices vetoriais da migration 006
# declaram. Trocar para outra dimensao pede DROP e recriar os dois, por
# migration nova; src/lib/embedding.ts estoura antes de o banco reclamar.
EMBEDDING_MODEL=

# Auth: magic link, um único e-mail permitido
AUTH_SECRET=
ALLOWED_EMAIL=
