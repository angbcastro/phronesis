# Neo4j AuraDB — HTTP Query API (nunca Bolt)
NEO4J_QUERY_URL=https://<id>.databases.neo4j.io/db/neo4j/query/v2
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Cloudflare R2 (bucket privado, sem acesso público)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# STT (Whisper com timestamps por palavra)
STT_API_KEY=
# STT_URL e STT_MODEL são opcionais; o padrão é a API do Whisper.

# Extração — usada a partir da slice 2
LLM_API_KEY=

# Auth: magic link, um único e-mail permitido
AUTH_SECRET=
ALLOWED_EMAIL=
