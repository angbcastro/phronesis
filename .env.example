# Neo4j AuraDB — HTTP Query API (nunca Bolt)
NEO4J_QUERY_URL=
NEO4J_USER=
NEO4J_PASSWORD=

# Cloudflare R2 (bucket privado, sem acesso público)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phronesis

# Vercel AI Gateway — porta única de modelo. Todo tráfego de LLM sai por
# aqui: STT agora, extração e deduplicação a partir da slice 2. É a única
# chave de modelo do sistema; chave de provedor não entra neste arquivo.
AI_GATEWAY_API_KEY=
# Opcional: troca de provedor sem tocar em código. Padrão: xai/grok-stt
# (é o único modelo deste Gateway com tempo por palavra — ARCHITECTURE.md §4.2.1)
STT_MODEL=
# Opcional: modelo da extracao de atomos. Padrao: zai/glm-5.3-flash
EXTRACAO_MODEL=
# Opcional: modelo que julga se duas entidades sao a mesma. Padrao: zai/glm-5.3-flash
DUPLICATAS_MODEL=

# Auth: magic link, um único e-mail permitido
AUTH_SECRET=
ALLOWED_EMAIL=
